<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
			<rules>
				<rule name="ReverseProxyInboundRule3" stopProcessing="true">
					<match url="(.*)" />
					<action type="Rewrite" url="http://localhost:4006/{R:1}" />
					<conditions>
                        <add input="{HTTP_HOST}" pattern="^g3-beta.player1.win$" />
					</conditions>
				</rule>
			</rules>
		</rewrite>
    </system.webServer>
</configuration>
